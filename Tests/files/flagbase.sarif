                    },
                    "message": {
                        "text": "Passing wrong flag type for 'ExAllocatePoolWithTag'. The flag should be of type POOL_TYPE. For more info see, https://docs.microsoft.com/en-us/windows-hardware/drivers/ddi/wdm/ne-wdm-_pool_type"
                    },
